      "parameters": {
        "html": "<!doctype html>\n<html dir=\"rtl\" lang=\"he\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>מסמך {{ $json.DocNumber }}</title>\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;700&display=swap');\n    * { box-sizing: border-box; }\n    body { font-family: 'Rubik', Arial, sans-serif; color: #1b2333; margin: 0; padding: 48px; font-size: 14px; }\n    .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid #1f2d5a; padding-bottom: 16px; }\n    .brand h1 { margin: 0; color: #1f2d5a; font-size: 26px; }\n    .brand .tagline { color: #6b7280; font-size: 12px; margin-top: 4px; }\n    .company { text-align: left; font-size: 12px; color: #4b5563; line-height: 1.6; }\n    .doc-meta { margin-top: 24px; display: flex; justify-content: space-between; }\n    .doc-meta .box h2 { margin: 0 0 8px; font-size: 18px; color: #1f2d5a; }\n    .doc-meta .box p { margin: 2px 0; }\n    .totals { margin-top: 20px; margin-left: auto; width: 300px; }\n    .totals .row { display: flex; justify-content: space-between; padding: 6px 0; }\n    .totals .grand { border-top: 2px solid #1f2d5a; margin-top: 6px; padding-top: 10px; font-size: 18px; font-weight: bold; color: #1f2d5a; }\n    .footer { margin-top: 48px; text-align: center; color: #9ca3af; font-size: 11px; border-top: 1px solid #e5e7eb; padding-top: 12px; }\n    .num { text-align: left; direction: ltr; }\n    .payment-box { margin-top: 24px; padding: 16px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; }\n    .payment-box p { margin: 4px 0; }\n    .related { margin-top: 16px; padding: 12px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; }\n    table { width: 100%; border-collapse: collapse; margin-top: 24px; }\n    th { background: #1f2d5a; color: #fff; padding: 10px; text-align: right; font-size: 13px; }\n    td { padding: 10px; border-bottom: 1px solid #e5e7eb; }\n    tr:nth-child(even) td { background: #f9fafb; }\n  </style>\n</head>\n<body>\n\n  <!-- כותרת העסק -->\n  <div class=\"header\">\n    <div class=\"brand\">\n      <h1>AI Electronics · איי.איי אלקטרוניקה</h1>\n      <div class=\"tagline\">מוצרי אלקטרוניקה מקוריים באחריות יבואן רשמי</div>\n    </div>\n    <div class=\"company\">\n      ח.פ / עוסק מורשה: 515-678-923<br>\n      רחוב הברזל 30, תל אביב<br>\n      טל' 03-555-1234 · info@aielectronics.co.il\n    </div>\n  </div>\n\n  <!-- פרטי המסמך + לקוח -->\n  <div class=\"doc-meta\">\n    <div class=\"box\">\n      <h2>{{ $json.TaxInvoiceId ? 'חשבונית מס' : $json.ReceiptId ? 'קבלה' : 'חשבונית' }}</h2>\n      <p>מספר מסמך: <strong>{{ $json.DocNumber }}</strong></p>\n      <p>תאריך: {{ $json.IssueDate }}</p>\n    </div>\n    <div class=\"box\">\n      <h2>לכבוד</h2>\n      <p><strong>{{ $json.CustomerName }}</strong></p>\n      <p>{{ $json.CustomerBusinessNumber ? 'ח.פ: ' + $json.CustomerBusinessNumber : '' }}</p>\n      <p>{{ $json.CustomerId }}</p>\n    </div>\n  </div>\n\n  <!-- טבלת פריטים — רק לחשבוניות ולחשבוניות מס -->\n  {{ $json.LineItems ? '<table><thead><tr><th>פריט</th><th class=\"num\">כמות</th><th class=\"num\">מחיר יחידה</th><th class=\"num\">סה\"כ</th></tr></thead><tbody>' + $json.LineItems + '</tbody></table>' : '' }}\n\n  <!-- סכומים -->\n  <div class=\"totals\">\n    {{ $json.Subtotal ? '<div class=\"row\"><span>סכום ביניים</span><span class=\"num\">' + $json.Subtotal + '₪</span></div>' : '' }}\n  {{ $json.VATRate ? '<div class=\"row\"><span>מע\"מ (' + (Number($json.VATRate) * 100) + '%)</span><span class=\"num\">' + Math.round(Number($json.Subtotal) * Number($json.VATRate)) + '₪</span></div>' : '' }}\n    <div class=\"row grand\">\n      <span>סה\"כ {{ $json.ReceiptId ? 'ששולם' : 'לתשלום' }}</span>\n      <span class=\"num\">{{ $json.Total ?? $json.Amount }}₪</span>\n    </div>\n  </div>\n\n  <!-- אמצעי תשלום — רק בקבלות -->\n  {{ $json.PaymentMethod ? '<div class=\"payment-box\"><p><strong>אמצעי תשלום:</strong> ' + $json.PaymentMethod + '</p></div>' : '' }}\n\n  <!-- חשבונית מקושרת — רק בקבלות -->\n  {{ $json.RelatedInvoice ? '<div class=\"related\"><p>עבור חשבונית מספר: <strong>' + $json.RelatedInvoice + '</strong></p></div>' : '' }}\n\n  <!-- פוטר -->\n  <div class=\"footer\">\n    תודה שבחרתם ב-AI Electronics · מסמך זה הופק אוטומטית על ידי מערכת ה-ERP\n  </div>\n\n</body>\n</html>"
